{
  "name": "dmflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && electron apps/desktop",
    "build": "node --import tsx scripts/build.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --config electron-builder.json --mac --arm64",
    "setup": "node --import tsx scripts/setup.ts",
    "deploy": "node --import tsx scripts/setup.ts --deploy",
    "worker:dev": "wrangler dev --config workers/api/wrangler.jsonc",
    "worker:types": "wrangler types --config workers/api/wrangler.jsonc workers/api/src/env.d.ts",
    "simulate:comment": "node --import tsx scripts/simulate.ts comment",
    "simulate:dm": "node --import tsx scripts/simulate.ts dm",
    "simulate:click": "node --import tsx scripts/simulate.ts click",
    "demo:server": "node --import tsx scripts/demo-server.ts",
    "pair": "node --import tsx scripts/pair.ts",
    "test:desktop": "node --import tsx scripts/desktop-test.ts",
    "postinstall": "node node_modules/electron/install.js",
    "test:worker": "node scripts/run-worker-tests.mjs",
    "format": "prettier --write apps packages workers/api/src/index.ts scripts tests docs *.json",
    "web:dev": "node apps/portal/server.mjs",
    "test:portal": "node --test tests/portal.test.mjs",
    "package:win": "npm run build && electron-builder --config electron-builder.json --win nsis --x64"
  },
  "dependencies": {
    "hono": "4.13.10",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "miniflare": "5.20260926.0-alpha",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.143.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
